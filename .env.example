# Copy this file to .env.local for local dev, or to .env.production on the
# server. Keep your real values in .local/secrets/ — never commit .env files.

# === Auth ===
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-strong-random-32-byte-hex-string
# Canonical HTTPS origin used for same-origin checks on public pre-check-in
# writes, so trust is never inferred from a forwarded Host header. Accepts a
# comma-separated list when the deployment legitimately answers on more than one
# hostname. Apex and www are treated as the same site automatically.
# Strongly recommended in production: when it is unset the check falls back to
# the request's own origin, which a spoofed Host header can defeat. The deploy
# scripts refuse to run without it.
PUBLIC_APP_URL=https://renttools.io

# Encrypts pre-check-in identity data and issued guest-form tokens at rest.
# Required before any unified guest link can be generated. Generate a distinct
# value with: openssl rand -hex 32
GUEST_DATA_ENCRYPTION_KEY=replace-with-distinct-random-32-byte-hex-string
# Version written into every new ciphertext. Increment this when rotating the
# current key; keep earlier keys in the JSON map below until all old data has
# been re-encrypted or expired.
GUEST_DATA_ENCRYPTION_KEY_VERSION=v1
# Example after rotating to v2:
# GUEST_DATA_ENCRYPTION_PREVIOUS_KEYS={"v1":"old-64-character-hex-key"}
GUEST_DATA_ENCRYPTION_PREVIOUS_KEYS=

# === Cron ===
# Used by /api/calendar/cron — only requests with ?secret=<this> are accepted
# (or Authorization: Bearer <this>). Generate the same way as JWT_SECRET.
CRON_SECRET=replace-with-strong-random-32-byte-hex-string

# === AI / passport extraction ===
# Legacy passport-OCR upload. Opt-OUT: anything other than "false" leaves it
# on, so shipping this change does not silently remove a feature hosts use.
# Set it to "false" once uploaded documents and extracted plaintext fields have
# a proven deletion/retention lifecycle.
# NOTE: NEXT_PUBLIC_ vars are inlined into the client bundle at BUILD time.
# Setting this here only reaches the server route — to hide the upload UI it
# must also be set for the build (see .github/workflows/deploy.yml).
NEXT_PUBLIC_LEGACY_PASSPORT_OCR_ENABLED=true
# Get a free key at https://aistudio.google.com
GOOGLE_GEMINI_API_KEY=

# === eVisitor test integration (disabled until synthetic E2E approval) ===
# Load these from the deployment secret manager. Never commit real values.
# The adapter currently rejects the production API by design.
EVISITOR_TEST_USERNAME=
EVISITOR_TEST_PASSWORD=
EVISITOR_TEST_API_KEY=

# Optional: override the Gemini model. Defaults to "gemini-2.5-flash".
# Note: gemini-2.0-flash is DEPRECATED and shuts down 2026-06-01.
# Free tier is generous (1500 req/day, 1M tokens/min). Paid tier is
# ~$0.0002 per passport extraction. https://ai.google.dev/gemini-api/docs/pricing
# GEMINI_MODEL=gemini-2.5-flash

# === Database ===
# The libSQL adapter supports both local SQLite and Turso. Pick one.

# A) Self-hosted SQLite (default — what renttools.io uses on the DO droplet)
DATABASE_URL=file:./data/prod.db

# B) Turso / libSQL cloud (alternative for self-hosters who want a hosted DB)
# Leave A unset and uncomment these.
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=

# === Google OAuth (optional — enables "Continue with Google" sign-in) ===
# Create credentials at https://console.cloud.google.com/apis/credentials
# - OAuth 2.0 client type: Web application
# - Authorized JavaScript origins: https://your-domain, http://localhost:3000
# - Authorized redirect URIs: https://your-domain/api/auth/google/callback,
#                              http://localhost:3000/api/auth/google/callback
# Scopes used: openid, email, profile (basic, no verification needed)
# Leave all three blank to disable the Google sign-in button entirely.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Same value as GOOGLE_OAUTH_CLIENT_ID; baked into the client bundle
# at build time so the Sign-In button knows whether to render.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# === Error tracking (optional) ===
# Get a DSN at https://sentry.io — Settings → Client Keys (DSN).
# Free tier: 5k errors/month. Leave blank to disable Sentry entirely.
NEXT_PUBLIC_SENTRY_DSN=

# Optional: auth token for uploading source maps (so stack traces show TS, not minified JS).
# Sentry → Settings → Auth Tokens → "Create New Token" with project:releases scope.
SENTRY_AUTH_TOKEN=

# === Transactional email (optional — enables email-verified signup + password reset) ===
# Get a key at https://resend.com and verify your sending domain first.
# Leave blank to disable: the password-reset flow then returns a friendly
# "email not configured" message instead of sending.
RESEND_API_KEY=
# Sender address — must be on a domain verified in your Resend account.
# Defaults to "RentTools <noreply@renttools.io>" when left blank.
EMAIL_FROM=
