--- /dev/null
+++ b/src/lib/calendar-overview.ts
@@ -0,0 +1,69 @@
+import type { Reservation } from "@/lib/types";
+
+export interface CalendarOverviewReservation {
+  id?: number;
+  name: string;
+  checkIn: string;
+  checkOut: string;
+  platform: string;
+  linkedEventUid: string | null;
+  linkedEventPlatform: string | null;
+  linkedEventRole: Reservation["linkedEventRole"];
+}
+
+export interface CalendarOverviewEvent {
+  platform: string;
+  uid: string;
+  summary: string;
+  startDate: string;
+  endDate: string;
+}
+
+export interface CalendarOverviewLink {
+  platform: string;
+  bufferBefore: number;
+  bufferAfter: number;
+}
+
+export interface CalendarOverviewOverride {
+  date: string;
+  type: "open" | "closed" | "cleaning";
+}
+
+export interface CalendarOverviewProperty {
+  id: number;
+  name: string;
+  minNights: number;
+  checkInTime: string;
+  checkOutTime: string;
+  bookingWindow: number;
+  cleaningEnabled: boolean;
+  canManage: boolean;
+  reservations: CalendarOverviewReservation[];
+  events: CalendarOverviewEvent[];
+  links: CalendarOverviewLink[];
+  overrides: CalendarOverviewOverride[];
+  syncFailed: boolean;
+}
+
+export interface CalendarOverviewResponse {
+  month: string;
+  startDate: string;
+  endDate: string;
+  properties: CalendarOverviewProperty[];
+}
+
+export function calendarOverviewMonth(value: unknown): {
+  month: string;
+  startDate: string;
+  endDate: string;
+  start: Date;
+  end: Date;
+} | null {
+  if (typeof value !== "string" || !/^(?:[1-9]\d{3})-(?:0[1-9]|1[0-2])$/.test(value)) return null;
+  const start = new Date(`${value}-01T00:00:00.000Z`);
+  const end = new Date(start);
+  end.setUTCMonth(end.getUTCMonth() + 1);
+  if (end.getUTCFullYear() > 9999) return null;
+  return { month: value, startDate: `${value}-01`, endDate: end.toISOString().slice(0, 10), start, end };
+}
diff --git a/src/lib/dashboard-navigation.test.ts b/src/lib/dashboard-navigation.test.ts
new file mode 100644
index 0000000..3833af7
--- /dev/null
+++ b/src/lib/dashboard-navigation.test.ts
@@ -0,0 +1,50 @@
+import { describe, expect, it } from "vitest";
+import { dashboardHref } from "./dashboard-navigation";
+
+const overview = {
+  propertyId: null,
+  reservationId: null,
+  overviewMonth: "2026-12",
+  overviewSearch: "Studio & loft",
+};
+
+function query(href: string) {
+  return Object.fromEntries(new URL(href, "https://example.invalid").searchParams);
+}
+
+describe("overview navigation", () => {
+  it("opens a card with the selected month and exact property filter intact", () => {
+    expect(query(dashboardHref(overview, { property: 7, reservation: 19, view: "overview" }))).toEqual({
+      property: "7", reservation: "19", view: "overview", overviewMonth: "2026-12", overviewSearch: "Studio & loft",
+    });
+  });
+
+  it("returns from a card to all rows without retaining a stale reservation", () => {
+    const current = { ...overview, propertyId: 7, reservationId: 19 };
+    expect(query(dashboardHref(current, { property: null, reservation: null, view: "overview" }))).toEqual({
+      view: "overview", overviewMonth: "2026-12", overviewSearch: "Studio & loft",
+    });
+  });
+
+  it("carries the overview context through an individual calendar and back", () => {
+    expect(query(dashboardHref({ ...overview, propertyId: 7, reservationId: 19 }, { property: 8, view: "calendar" }))).toEqual({
+      property: "8", overviewMonth: "2026-12", overviewSearch: "Studio & loft",
+    });
+    expect(query(dashboardHref({ ...overview, propertyId: 8 }, { property: null, reservation: null, view: "overview" }))).toEqual({
+      view: "overview", overviewMonth: "2026-12", overviewSearch: "Studio & loft",
+    });
+  });
+
+  it("accepts a year transition and an explicitly cleared filter", () => {
+    expect(query(dashboardHref(overview, { view: "overview", overviewMonth: "2027-01", overviewSearch: "" }))).toEqual({
+      view: "overview", overviewMonth: "2027-01",
+    });
+  });
+
+  it("preserves existing default dashboard and property URLs", () => {
+    const current = { ...overview, overviewMonth: null, overviewSearch: "" };
+    expect(dashboardHref(current, {})).toBe("/dashboard");
+    expect(dashboardHref(current, { property: 7 })).toBe("/dashboard?property=7");
+    expect(dashboardHref(current, { property: 7, reservation: 19 })).toBe("/dashboard?property=7&reservation=19");
+  });
+});
diff --git a/src/lib/dashboard-navigation.ts b/src/lib/dashboard-navigation.ts
new file mode 100644
index 0000000..b1ac713
--- /dev/null
+++ b/src/lib/dashboard-navigation.ts
@@ -0,0 +1,35 @@
+interface DashboardLocation {
+  propertyId: number | null;
+  reservationId: number | null;
+  overviewMonth: string | null;
+  overviewSearch: string;
+}
+
+export interface DashboardNavigation {
+  property?: number | null;
+  reservation?: number | null;
+  view?: string;
+  overviewMonth?: string;
+  overviewSearch?: string;
+}
+
+export function dashboardHref(current: DashboardLocation, next: DashboardNavigation): string {
+  const propertyId = next.property !== undefined ? next.property : current.propertyId;
+  const reservationId = next.reservation !== undefined
+    ? next.reservation
+    : next.property !== undefined ? null : current.reservationId;
+  const defaultView = reservationId ? "guests" : propertyId ? "calendar" : "dashboard";
+  const view = next.view || defaultView;
+  const month = next.overviewMonth ?? current.overviewMonth;
+  const query = next.overviewSearch ?? current.overviewSearch;
+  const params = new URLSearchParams();
+
+  if (propertyId) params.set("property", String(propertyId));
+  if (reservationId) params.set("reservation", String(reservationId));
+  if (view !== defaultView) params.set("view", view);
+  if (month) params.set("overviewMonth", month);
+  if (query) params.set("overviewSearch", query);
+
+  const search = params.toString();
+  return search ? `/dashboard?${search}` : "/dashboard";
+}
